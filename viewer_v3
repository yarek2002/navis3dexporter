            <button id="resetOpacityBtn" class="btn success" style="background:#4aa56f; cursor:pointer; padding: 8px 16px; border: none; border-radius: 6px; color: white;">100% прозрачности</button>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    // === ПОЛУЧАЕМ ЭЛЕМЕНТЫ ===
    const slider = document.getElementById('opSlider');
