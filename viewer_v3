<script>
// ==================== ПЕРЕКЛЮЧЕНИЕ РЕЖИМОВ ОТОБРАЖЕНИЯ ====================
let renderMode = '3d';
let originalLights = [];
let previewLights = [];

function setupPreviewMode() {
    // Сохраняем текущие источники света если еще не сохраняли
    if (originalLights.length === 0) {
        scene.traverse(node => {
            if (node.isLight && !node.name?.startsWith('preview_')) {
                originalLights.push({
                    light: node,
                    intensity: node.intensity,
                    visible: node.visible
                });
            }
        });
    }
    
    // Выключаем все существующие источники света (кроме preview)
    scene.traverse(node => {
        if (node.isLight && !node.name?.startsWith('preview_')) {
            node.visible = false;
        }
    });
    
    // Удаляем старые preview если есть
    previewLights.forEach(light => {
        if (light.parent) scene.remove(light);
    });
    previewLights = [];
    
    // Создаем яркое равномерное освещение
    const ambientLight = new THREE.AmbientLight(0xffffff, 1.2);
    ambientLight.name = 'preview_ambient';
    scene.add(ambientLight);
    previewLights.push(ambientLight);
    
    // Добавляем яркие направленные источники со всех сторон
    const directions = [
        { pos: [ 2,  2,  2], intensity: 1.0 },
        { pos: [-2,  2, -2], intensity: 0.8 },
        { pos: [ 2, -2,  2], intensity: 0.8 },
        { pos: [-2, -2, -2], intensity: 0.8 },
        { pos: [ 0,  3,  0], intensity: 0.6 },
        { pos: [ 0, -1,  0], intensity: 0.4 }
    ];
    
    directions.forEach((dir, i) => {
        const light = new THREE.DirectionalLight(0xffffff, dir.intensity);
        light.position.set(dir.pos[0], dir.pos[1], dir.pos[2]);
        light.name = `preview_light_${i}`;
        light.castShadow = false;
        scene.add(light);
        previewLights.push(light);
    });
    
    // Выключаем тени в рендерере для preview режима
    if (renderer) renderer.shadowMap.enabled = false;
    
    // Убираем тени у всех объектов
    scene.traverse(node => {
        if (node.isMesh) {
            node.castShadow = false;
            node.receiveShadow = false;
        }
    });
}

function setup3dMode() {
    // Удаляем preview освещение
    previewLights.forEach(light => {
        if (light.parent) scene.remove(light);
    });
    previewLights = [];
    
    // Восстанавливаем оригинальные источники света
    originalLights.forEach(item => {
        if (item.light) {
            item.light.visible = item.visible !== undefined ? item.visible : true;
            item.light.intensity = item.intensity;
        }
    });
    
    // Включаем тени
    if (renderer) renderer.shadowMap.enabled = true;
    
    // Восстанавливаем тени у объектов
    scene.traverse(node => {
        if (node.isMesh) {
            node.castShadow = true;
            node.receiveShadow = true;
        }
    });
}

function toggleRenderMode(enable3d) {
    if (enable3d) {
        renderMode = '3d';
        setup3dMode();
        addDebug('🎨 Режим: 3D (с тенями)', 'success');
    } else {
        renderMode = 'preview';
        setupPreviewMode();
        addDebug('🎨 Режим: Preview (яркое равномерное освещение)', 'success');
    }
    
    // Обновляем UI
    const toggle = document.getElementById('shadowsEnabledToggle');
    const state = document.getElementById('shadowsEnabledState');
    if (toggle) toggle.checked = enable3d;
    if (state) state.textContent = enable3d ? '3D' : 'Preview';
    
    // Принудительный рендер
    if (renderer && scene && camera) {
        renderer.render(scene, camera);
    }
}

// Инициализация
setTimeout(() => {
    const modeToggle = document.getElementById('shadowsEnabledToggle');
    if (modeToggle) {
        // Удаляем старые обработчики, чтобы не было дублирования
        const newToggle = modeToggle.cloneNode(true);
        modeToggle.parentNode.replaceChild(newToggle, modeToggle);
        
        newToggle.addEventListener('change', function(e) {
            toggleRenderMode(e.target.checked);
        });
    }
    
    // Начальное состояние - 3D режим (тени включены)
    renderMode = '3d';
    
    addDebug('🎨 Переключение режимов отображения инициализировано', 'info');
    addDebug('💡 ON = 3D режим (с тенями), OFF = Preview режим (яркое равномерное освещение)', 'info');
}, 2000);
