function loadModelWithDependencies(gltfFile, modelName) {
    return new Promise((resolve, reject) => {
        const reader = new FileReader();

        reader.onload = function(e) {
            const arrayBuffer = e.target.result;
            const loader = new THREE.GLTFLoader();

            // Подготовка URL-ов для .bin файлов
            const binUrls = new Map();
            v2.fileManager.bin.forEach((file, name) => {
                binUrls.set(name, URL.createObjectURL(file));
            });

            loader.manager.setURLModifier((url) => {
                if (binUrls.has(url)) return binUrls.get(url);
                return url;
            });

            loader.parse(
                arrayBuffer,
                '',
                function(gltf) {
                    // Освобождаем ObjectURL
                    binUrls.forEach(url => URL.revokeObjectURL(url));

                    const model = gltf.scene;
                    ensureMultiGroup();

                    // === ЦЕНТРИРОВАНИЕ КАЖДОЙ ЧАСТИ ===
                    const box = new THREE.Box3().setFromObject(model);
                    const center = box.getCenter(new THREE.Vector3());

                    // Опционально: опустить модель на "пол"
                    // const size = box.getSize(new THREE.Vector3());
                    // model.position.y -= size.y / 2;

                    v2.multiGroup.add(model);

                    const modelId = 'v2_model_' + Date.now() + '_' + Math.random().toString(16).slice(2);

                    model.traverse(node => {
                        if (node.isMesh) {
                            node.userData.parentModelName = modelName;
                            node.userData.parentModelId = modelId;
                            node.userData.modelName = modelName;
                        }
                    });

                    v2.modelsMap.set(modelId, {
                        mesh: model,
                        name: modelName,
                        visible: true,
                        originalPosition: model.position.clone()
                    });

                    addDebug(`✅ Часть "${modelName}" загружена и прицентрирована`, 'success');
                    resolve({ id: modelId });
                },
                undefined,
                function(error) {
                    binUrls.forEach(url => URL.revokeObjectURL(url));
                    addDebug(`❌ Ошибка парсинга GLTF "${modelName}": ${error.message || error}`, 'error');
                    reject(error);
                }
            );
        };

        reader.onerror = function(error) {
            addDebug(`❌ Ошибка чтения файла ${modelName}`, 'error');
            reject(error);
        };

        reader.readAsArrayBuffer(gltfFile);
    });
}
window.removeModel = function(id) {
    const modelData = v2.modelsMap.get(id);
    if (!modelData) {
        addDebug(`Модель с id ${id} не найдена`, 'warning');
        return;
    }

    const mesh = modelData.mesh;           // ← это корневой Group/Object3D части

    if (mesh) {
        // 1. Удаляем из multiGroup (главное!)
        if (mesh.parent) {
            mesh.parent.remove(mesh);
        } else if (v2.multiGroup) {
            v2.multiGroup.remove(mesh);
        }

        // 2. Полная очистка памяти (очень важно для GLTF)
        disposeObject(mesh);
    }

    // 3. Удаляем из карты
    v2.modelsMap.delete(id);

    // 4. Обновляем всё остальное
    recalculateGlobalBoundingBox();
    updateModelsList();
    updateV2ModelStats();
    updateCameraToCenter();   // если нужно

    if (typeof syncLargeModalIfOpen === 'function') syncLargeModalIfOpen();

    addDebug(`🗑️ Удалена часть: ${modelData.name} (id: ${id})`, 'success');
};

function disposeObject(object) {
    if (!object) return;

    object.traverse((node) => {
        if (node.isMesh) {
            // Геометрия
            if (node.geometry) {
                node.geometry.dispose();
            }

            // Материалы
            const materials = Array.isArray(node.material) ? node.material : [node.material];
            materials.forEach((mat) => {
                if (!mat) return;

                // Текстуры
                if (mat.map) mat.map.dispose();
                if (mat.normalMap) mat.normalMap.dispose();
                if (mat.roughnessMap) mat.roughnessMap.dispose();
                if (mat.metalnessMap) mat.metalnessMap.dispose();
                if (mat.emissiveMap) mat.emissiveMap.dispose();

                mat.dispose();
            });
        }
    });

    if (object.animations) {
        object.animations.length = 0;
    }
}

