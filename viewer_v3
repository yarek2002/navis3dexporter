<script>
// ========== КАРКАСНЫЙ РЕЖИМ ДЛЯ КОНКРЕТНОГО ОБЪЕКТА ==========

// Храним оригинальные материалы для каждого объекта
const objectOriginalMaterials = new WeakMap();

function toggleWireframeForObject(object, enable) {
    if (!object || !object.isObject3D) return;

    // Проходим по всем мешам внутри объекта (включая вложенные)
    object.traverse((node) => {
        if (!node.isMesh || !node.material) return;

        const materials = Array.isArray(node.material) ? node.material : [node.material];

        materials.forEach((mat, index) => {
            if (!mat) return;

            // Сохраняем оригинальный материал при первом переключении
            if (!objectOriginalMaterials.has(node)) {
                objectOriginalMaterials.set(node, materials.map(m => m.clone()));
            }

            if (enable) {
                // === ВКЛЮЧАЕМ КАРКАС ===
                mat.wireframe = true;
                mat.wireframeLinewidth = 3;

                // Делаем каркас ярким и контрастным
                if (mat.color) {
                    mat.color.setHex(0x00ffff);     // ярко-бирюзовый
                }
                mat.transparent = true;
                mat.opacity = 0.9;
                mat.depthTest = true;
            } 
            else {
                // === ВЫКЛЮЧАЕМ КАРКАС — возвращаем оригинал ===
                const originals = objectOriginalMaterials.get(node);
                if (originals && originals[index]) {
                    const orig = originals[index];
                    mat.wireframe = false;
                    if (mat.color && orig.color) mat.color.copy(orig.color);
                    mat.opacity = orig.opacity !== undefined ? orig.opacity : 1;
                    mat.transparent = orig.transparent || false;
                    mat.depthTest = true;
                }
            }

            mat.needsUpdate = true;
        });
    });

    const action = enable ? '🔲 Каркас включён' : '◼️ Каркас выключен';
    addDebug(`${action} для: ${getModelName(object)}`, enable ? 'success' : 'info');
}

// Глобальная функция для контекстного меню
window.contextToggleWireframe = function() {
    if (!contextMenuTarget) {
        hideContextMenu();
        return;
    }

    // Определяем, включён ли уже каркас у этого объекта
    let isCurrentlyWireframe = false;
    
    contextMenuTarget.traverse((node) => {
        if (node.isMesh && node.material) {
            const mat = Array.isArray(node.material) ? node.material[0] : node.material;
            if (mat && mat.wireframe === true) {
                isCurrentlyWireframe = true;
                return false; // выходим
            }
        }
    });

    // Переключаем в противоположное состояние
    toggleWireframeForObject(contextMenuTarget, !isCurrentlyWireframe);

    hideContextMenu();

    // Обновляем списки (на всякий случай)
    if (typeof updateModelsList === 'function') updateModelsList();
    if (typeof syncLargeModalIfOpen === 'function') syncLargeModalIfOpen();
};
