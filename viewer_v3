<script>
// ========== ПРОЗРАЧНОСТЬ ЧЕРЕЗ КОНТЕКСТНОЕ МЕНЮ (РАБОЧАЯ ВЕРСИЯ) ==========

// Глобальная переменная для хранения текущего объекта
let currentOpacityTarget = null;

// Функция применения прозрачности к объекту
function setObjectOpacity(obj, transparencyValue) {
    if (!obj) {
        console.error('setObjectOpacity: obj is null');
        return false;
    }
    
    let changed = false;
    
    // Если obj - это группа (Group), проходим по всем детям
    const processMesh = (mesh) => {
        if (!mesh.isMesh) return;
        if (!mesh.material) return;
        
        const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
        
        materials.forEach((mat) => {
            if (!mat) return;
            
            // Сохраняем оригинальные значения при первом изменении
            if (mat.userData.originalOpacity === undefined) {
                mat.userData.originalOpacity = mat.opacity !== undefined ? mat.opacity : 1;
                mat.userData.originalTransparent = mat.transparent || false;
                if (mat.color) {
                    mat.userData.originalColor = mat.color.clone();
                }
                console.log(`Сохранён оригинал для ${mesh.name}: opacity=${mat.userData.originalOpacity}`);
            }
            
            // Применяем прозрачность (transparencyValue: 0=видимый, 1=невидимый)
            const newOpacity = 1 - transparencyValue;
            
            if (newOpacity < 1.0) {
                mat.transparent = true;
                mat.opacity = newOpacity;
            } else {
                mat.opacity = mat.userData.originalOpacity;
                mat.transparent = mat.userData.originalTransparent;
            }
            
            mat.needsUpdate = true;
            changed = true;
        });
    };
    
    // Обрабатываем объект
    if (obj.isMesh) {
        processMesh(obj);
    } else if (obj.isGroup || obj.children) {
        obj.traverse((child) => {
            if (child.isMesh) {
                processMesh(child);
            }
        });
    }
    
    return changed;
}

// Функция получения текущей прозрачности объекта
function getCurrentObjectOpacity(obj) {
    if (!obj) return 0;
    
    let opacity = null;
    
    const checkMesh = (mesh) => {
        if (opacity !== null) return;
        if (!mesh.isMesh) return;
        if (!mesh.material) return;
        
        const materials = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
        for (let mat of materials) {
            if (mat && mat.transparent && typeof mat.opacity === 'number') {
                opacity = 1 - mat.opacity;
                break;
            }
        }
    };
    
    if (obj.isMesh) {
        checkMesh(obj);
    } else if (obj.traverse) {
        obj.traverse(checkMesh);
    }
    
    return opacity !== null ? opacity : 0;
}

