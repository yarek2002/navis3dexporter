        valueEl.textContent = percent + "%";
        
        console.log(`Слайдер: ${percent}%`);
        
        if (currentOpacityTarget) {
            const result = setObjectOpacity(currentOpacityTarget, transparencyValue);
            console.log(`Применено: ${result ? 'успешно' : 'ошибка'}`);
            
            // Принудительный рендер
            if (typeof renderer !== 'undefined' && renderer && typeof scene !== 'undefined' && typeof camera !== 'undefined') {
