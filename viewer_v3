        <input type="range" id="opSlider" min="0" max="1" step="0.01" value="0"
               style="width:100%; height:9px; accent-color:#4a6fa5; cursor: pointer;">
        
        <div id="opValue" style="margin:15px 0 25px 0; font-size:22px; font-weight:bold; color:#4a6fa5;">
            0%
        </div>
        
        <div style="margin-bottom:15px; font-size:11px; color:#888;">
            💡 0% = полностью видимый | 100% = полностью прозрачный
        </div>

        <div style="display:flex; gap:12px; justify-content:center;">
