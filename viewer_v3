<script>
// ====================== FLY MODE С F ДЛЯ ВНИЗ ======================
let moveSpeed = 1.0;
let lookSpeed = 0.002;
let isDraggingMouse = false;
let previousMouseX = 0;
let previousMouseY = 0;

// Параметры для ускорения
let isSprinting = false;
const NORMAL_SPEED = 1.0;
const SPRINT_SPEED = 3.0;

const keys = {};

// Переключение режима
function toggleFlyMode(enabled) {
  isFlyMode = enabled;
  const stateEl = document.getElementById('firstPersonState');

  if (enabled) {
    if (controls) controls.enabled = false;
    
    // Сохраняем текущий поворот камеры
    const currentYaw = camera.rotation.y;
    const currentPitch = camera.rotation.x;
    camera.rotation.set(currentPitch, currentYaw, 0);
    camera.rotation.order = 'YXZ'; // Важно для правильного порядка поворотов
    
    stateEl.textContent = 'ON';
    stateEl.style.color = enabled ? '#00ffcc' : '#aaa';
    
    addDebug('✈️ Fly Mode включён • WASD — движение • Space — вверх • F — вниз • Shift — ускорение', 'success');
    showFlyNotification();
    
    isDraggingMouse = false;
    renderer.domElement.style.cursor = 'default';
  } else {
    if (controls) controls.enabled = true;
    stateEl.textContent = 'OFF';
    stateEl.style.color = '#aaa';
    addDebug('✈️ Fly Mode выключен', 'info');
    isDraggingMouse = false;
  }
}

// Обновление движения
function updateFlyMovement(delta) {
  if (!isFlyMode) return;

  // Получаем направление камеры
  const forward = new THREE.Vector3();
  camera.getWorldDirection(forward);
  
  // Создаем векторы для движения
  const moveDirection = new THREE.Vector3();
  
  // Движение вперед-назад (горизонтальная плоскость)
  if (keys['KeyW']) {
    moveDirection.x += forward.x;
    moveDirection.z += forward.z;
  }
  if (keys['KeyS']) {
    moveDirection.x -= forward.x;
    moveDirection.z -= forward.z;
  }
  
  // Движение влево-вправо
  if (keys['KeyA'] || keys['KeyD']) {
    const right = new THREE.Vector3();
    right.crossVectors(forward, new THREE.Vector3(0, 1, 0)).normalize();
    
    if (keys['KeyA']) {
      moveDirection.x -= right.x;
      moveDirection.z -= right.z;
    }
    if (keys['KeyD']) {
      moveDirection.x += right.x;
      moveDirection.z += right.z;
    }
  }
  
  // Нормализуем горизонтальное движение
  if (moveDirection.x !== 0 || moveDirection.z !== 0) {
    moveDirection.normalize();
  }
  
  // Вертикальное движение
  let verticalMove = 0;
  if (keys['Space']) verticalMove += 1;
  if (keys['KeyF']) verticalMove -= 1;
  
  // Скорость
  let currentSpeed = isSprinting ? SPRINT_SPEED : NORMAL_SPEED;
  
  // Применяем движение
  camera.position.x += moveDirection.x * currentSpeed * delta;
  camera.position.z += moveDirection.z * currentSpeed * delta;
  camera.position.y += verticalMove * currentSpeed * delta;
}

// Обработка движения мыши - ПРЯМОЕ ИЗМЕНЕНИЕ КАМЕРЫ
function onMouseMove(e) {
    if (!isFlyMode || !isDraggingMouse) return;

    const deltaX = e.clientX - previousMouseX;
    const deltaY = e.clientY - previousMouseY;

    // Поворачиваем камеру напрямую
    camera.rotation.y -= deltaX * lookSpeed * 1.2;
    camera.rotation.x -= deltaY * lookSpeed * 1.0;
    
    // Ограничиваем угол наклона (чтобы не перевернуться)
    camera.rotation.x = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, camera.rotation.x));
    
    // Обнуляем крен (roll) для предотвращения заваливания
    camera.rotation.z = 0;

    previousMouseX = e.clientX;
    previousMouseY = e.clientY;
}

// Обработка нажатий кнопок мыши
function onMouseDown(e) {
  if (isFlyMode && e.button === 0) {
    e.preventDefault();
    e.stopPropagation();
    isDraggingMouse = true;
    previousMouseX = e.clientX;
    previousMouseY = e.clientY;
    renderer.domElement.style.cursor = 'grabbing';
  }
}

function onMouseUp(e) {
  if (e.button === 0) {
    isDraggingMouse = false;
    renderer.domElement.style.cursor = 'default';
  }
}

function onMouseLeave() {
  isDraggingMouse = false;
  renderer.domElement.style.cursor = 'default';
}

// Управление клавишами
document.addEventListener('keydown', (e) => {
  keys[e.code] = true;
  
  // Ускорение по Shift
  if (e.code === 'ShiftLeft') {
    isSprinting = true;
    e.preventDefault();
  }
  
  // Предотвращаем скролл при Space и F
  if (e.code === 'Space' || e.code === 'KeyF') {
    e.preventDefault();
  }
});

document.addEventListener('keyup', (e) => {
  keys[e.code] = false;
  
  if (e.code === 'ShiftLeft') {
    isSprinting = false;
  }
});

// Уведомление
function showFlyNotification() {
  const notif = document.getElementById('fp-notification');
  if (notif) {
    notif.innerHTML = `
      <div style="font-size:18px; color:#4aa56f;">✈️ Fly Mode активирован</div>
      <div style="margin-top:8px; font-size:14.5px;">
        🖱️ Левая кнопка мыши — поворот<br>
        ⌨️ WASD — движение<br>
        ␣ Space — вверх • <span style="color:#ffaa00;">F — вниз</span><br>
        🚀 Shift — ускорение
      </div>
    `;
    notif.style.display = 'block';
    setTimeout(() => { notif.style.display = 'none'; }, 5000);
  }
}

// Подключение тумблера
document.addEventListener('DOMContentLoaded', function() {
  const toggle = document.getElementById('firstPersonToggle');
  if (toggle) {
    toggle.addEventListener('change', function(e) {
      toggleFlyMode(e.target.checked);
    });
  }
});

// Настройка обработчиков
if (renderer && renderer.domElement) {
  renderer.domElement.removeEventListener('mousedown', onMouseDown);
  renderer.domElement.removeEventListener('mouseup', onMouseUp);
  renderer.domElement.removeEventListener('mouseleave', onMouseLeave);
  
  renderer.domElement.addEventListener('mousedown', onMouseDown);
  renderer.domElement.addEventListener('mouseup', onMouseUp);
  renderer.domElement.addEventListener('mouseleave', onMouseLeave);
}

// Убедимся, что обработчики событий добавлены
document.removeEventListener('mouseup', onMouseUp);
document.removeEventListener('mousemove', onMouseMove);
document.addEventListener('mouseup', onMouseUp);
document.addEventListener('mousemove', onMouseMove);
</script>
