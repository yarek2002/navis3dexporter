    // Получаем текущую прозрачность
    const currentOpacity = getCurrentObjectOpacity(targetPart);
    slider.value = currentOpacity;
    valueEl.textContent = Math.round(currentOpacity * 100) + "%";
    
    // === ОБРАБОТЧИК СЛАЙДЕРА (ГЛАВНЫЙ) ===
    const onSliderChange = function(e) {
