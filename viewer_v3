};
// Настройка слайдеров
const sliderConfigs = [
    { id: 'clipX', plane: 'X1', side: 'right' },
    { id: 'clipX2', plane: 'X2', side: 'left' },
    { id: 'clipY', plane: 'Y1', side: 'top' },
    { id: 'clipY2', plane: 'Y2', side: 'bottom' },
    { id: 'clipZ', plane: 'Z1', side: 'back' },
    { id: 'clipZ2', plane: 'Z2', side: 'front' }
];

sliderConfigs.forEach(config => {
    const slider = document.getElementById(config.id);
    if (slider) {
        // Меняем только диапазон на -10 до 10
        slider.min = -10;
        slider.max = 10;
        // НЕ меняем slider.value! Оставляем то значение, что установлено в HTML
        
function updatePlane(value) {

    if (config.side === 'right') {
        clipPlanes.X1.constant = -value;   // min slider => начальное положение
    } 
    else if (config.side === 'left') {
        clipPlanes.X2.constant = -value;
    }
    else if (config.side === 'top') {
        clipPlanes.Y1.constant = -value;
    }
    else if (config.side === 'bottom') {
        clipPlanes.Y2.constant = -value;
    }
    else if (config.side === 'back') {
        clipPlanes.Z1.constant = -value;   // ← ВАЖНО
    }
    else if (config.side === 'front') {
        clipPlanes.Z2.constant = -value;   // спереди -> назад
    }
    
    if (clippingEnabled) {
        applyClippingToAllModels();
    }

    if (showClipPlanes) {
        updateClipPlaneHelpers();
    }
}
        
        // Вызываем с текущим значением слайдера
        updatePlane(parseFloat(slider.value));
        
        slider.addEventListener('input', function(e) {
            updatePlane(parseFloat(e.target.value));
        });
    }
});
      // Функция для добавления сообщений в окно отладки
