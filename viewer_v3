    }
    
    wireframeEnabled = enabled;
    
    // === ПРИНУДИТЕЛЬНО ОБНОВЛЯЕМ UI ===
    const toggleInput = document.querySelector('#wireframeToggle');
    const stateSpan = document.querySelector('#wireframeState');
    
    if (toggleInput) {
        toggleInput.checked = enabled;
        console.log('✅ Тумблер обновлён:', enabled);
    } else {
        console.error('❌ Элемент #wireframeToggle не найден!');
    }
    
    if (stateSpan) {
        stateSpan.textContent = enabled ? 'ON' : 'OFF';
        stateSpan.style.color = enabled ? '#00ffcc' : '#aaa';
    }
    
    console.log(`🔲 Каркасный режим: ${enabled ? 'ВКЛЮЧЁН' : 'ВЫКЛЮЧЕН'}`);
    
    // Применяем ко всей сцене
    if (typeof scene !== 'undefined' && scene) {
        scene.traverse((node) => {
            if (node.isMesh && node.material) {
                const materials = Array.isArray(node.material) ? node.material : [node.material];
                
                materials.forEach((mat) => {
                    if (!mat) return;
                    
                    if (enabled) {
                        // Включаем каркас
                        if (!originalMaterials.has(node)) {
                            originalMaterials.set(node, {
                                color: mat.color ? mat.color.clone() : null,
                                opacity: mat.opacity,
                                transparent: mat.transparent,
                                wireframe: mat.wireframe
                            });
                        }
                        
                        mat.wireframe = true;
                        if (mat.color) mat.color.setHex(0x00ffcc);
                        mat.transparent = true;
                        mat.opacity = 0.95;
                    } else {
                        // Выключаем каркас
                        const original = originalMaterials.get(node);
                        if (original) {
                            mat.wireframe = original.wireframe || false;
                            if (mat.color && original.color) mat.color.copy(original.color);
                            mat.opacity = original.opacity;
                            mat.transparent = original.transparent;
                            originalMaterials.delete(node);
                        } else {
                            mat.wireframe = false;
                        }
                    }
                    
                    mat.needsUpdate = true;
                });
            }
        });
        
        if (typeof renderer !== 'undefined' && renderer) {
            renderer.render(scene, camera);
        }
    }
    
    if (typeof addDebug === 'function') {
        addDebug(`Каркасный режим: ${enabled ? 'ВКЛЮЧЁН' : 'ВЫКЛЮЧЕН'}`, enabled ? 'success' : 'info');
    }
}

// === ИНИЦИАЛИЗАЦИЯ С НЕСКОЛЬКИМИ СПОСОБАМИ ПЕРЕХВАТА ===
function initWireframe() {
    console.log('🔄 Инициализация каркасного режима...');
    
    // Ищем тумблер
    const toggle = document.querySelector('#wireframeToggle');
    
    if (!toggle) {
        console.error('❌ Не найден элемент #wireframeToggle!');
        return;
    }
    
    // Способ 1: Стандартный обработчик
    toggle.addEventListener('change', function(e) {
        e.stopPropagation();
        console.log('🎯 Событие change сработало! checked:', e.target.checked);
        toggleWireframe(e.target.checked);
    });
    
    // Способ 2: Дублируем на click (на случай, если change не срабатывает)
    toggle.addEventListener('click', function(e) {
        console.log('🖱️ Клик по тумблеру, checked после клика:', toggle.checked);
    });
    
    // Способ 3: Наблюдатель за атрибутом checked (резервный)
    let lastChecked = toggle.checked;
    setInterval(() => {
        if (toggle.checked !== lastChecked) {
            console.log('🔄 Изменение detected через интервал:', toggle.checked);
            lastChecked = toggle.checked;
            toggleWireframe(toggle.checked);
        }
    }, 100);
    
    console.log('✅ Каркасный режим инициализирован');
}

// Запускаем инициализацию
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWireframe);
} else {
    initWireframe();
}

