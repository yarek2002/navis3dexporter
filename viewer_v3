<script>
// ====================== УЛУЧШЕННАЯ СИСТЕМА ВЫБОРА ОБЪЕКТОВ (ПОДДЕРЖКА GLB) ======================

let selectedObject = null;
let raycaster = new THREE.Raycaster();
let mouse = new THREE.Vector2();

// === ОЧИСТКА ПОДСВЕТКИ ===
function clearHighlight() {
    if (selectedObject && selectedObject.material) {
        const materials = Array.isArray(selectedObject.material) ? selectedObject.material : [selectedObject.material];
        materials.forEach(mat => {
            if (mat.emissive) {
                mat.emissive.setHex(selectedObject.userData.originalEmissive || 0x000000);
                if (selectedObject.userData.originalEmissiveIntensity !== undefined) {
                    mat.emissiveIntensity = selectedObject.userData.originalEmissiveIntensity;
                }
            }
        });
    }
    selectedObject = null;
}

// === ПОДСВЕТКА ОБЪЕКТА ===
function highlightObject(object) {
    clearHighlight();
    if (!object || !object.material) return;

    const materials = Array.isArray(object.material) ? object.material : [object.material];
    materials.forEach(mat => {
        if (mat.emissive !== undefined) {
            if (object.userData.originalEmissive === undefined) {
                object.userData.originalEmissive = mat.emissive.getHex();
                object.userData.originalEmissiveIntensity = mat.emissiveIntensity || 0;
            }
            mat.emissive.setHex(0x44aaff);   // ярко-голубая подсветка
            mat.emissiveIntensity = 0.5;
        }
    });
    selectedObject = object;
}

// === ПОЛУЧЕНИЕ ОБЪЕКТА ПО КЛИКУ (С ПРИОРИТЕТОМ ДЛЯ GLB ЧАСТЕЙ) ===
function getTargetObjectFromClick(event) {
    if (!renderer || !renderer.domElement) return null;
    
    const rect = renderer.domElement.getBoundingClientRect();
    
    mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

    raycaster.setFromCamera(mouse, camera);

    // Рекурсивно по всей сцене
    const intersects = raycaster.intersectObject(scene, true);
    if (intersects.length === 0) return null;

    let hitObject = intersects[0].object;
    
    // === ПРИОРИТЕТ 1: Поиск GLB частей (item1_1, item2_1 и т.д.) ===
    let checkObject = hitObject;
    let depth = 0;
    const maxDepth = 15;
    
    while (checkObject && checkObject !== scene && depth < maxDepth) {
        // Проверяем имя объекта
        if (checkObject.name && /^item\d+_\d+$/i.test(checkObject.name)) {
            console.log(`🎯 Выбрана GLB часть: ${checkObject.name}`);
            return checkObject;
        }
        
        // Проверяем userData
        if (checkObject.userData) {
            if (checkObject.userData.partName && /^item\d+_\d+$/i.test(checkObject.userData.partName)) {
                console.log(`🎯 Выбрана GLB часть (userData): ${checkObject.userData.partName}`);
                return checkObject;
            }
            // v2 части
            if (checkObject.userData.parentModelId || checkObject.userData.parentModelName || checkObject.userData.modelName) {
                return checkObject;
            }
        }
        
        // Проверяем осмысленные имена (не технические)
        if (checkObject.name && 
            checkObject.name.length > 2 && 
            !checkObject.name.startsWith('Object_') && 
            !checkObject.name.startsWith('Mesh_') && 
            !checkObject.name.startsWith('_') &&
            !/^\d+$/.test(checkObject.name) &&
            checkObject.name !== 'Scene' &&
            checkObject.name !== 'Group') {
            return checkObject;
        }
        
        checkObject = checkObject.parent;
        depth++;
    }
    
    // === ПРИОРИТЕТ 2: Если нашли меш с осмысленным именем ===
    if (hitObject.isMesh && hitObject.name && hitObject.name.length > 2 && 
        !hitObject.name.startsWith('Object_') && !hitObject.name.startsWith('Mesh_')) {
        return hitObject;
    }
    
    // === ПРИОРИТЕТ 3: Возвращаем первый попавшийся меш ===
    for (let intersect of intersects) {
        if (intersect.object.isMesh) {
            return intersect.object;
        }
    }
    
    return hitObject;
}

// === ПОЛУЧЕНИЕ ИМЕНИ МОДЕЛИ (С ПОДДЕРЖКОЙ GLB ЧАСТЕЙ) ===
function getModelName(obj) {
    if (!obj) return 'Без имени';

    // === ПРИОРИТЕТ 1: GLB части item1_1, item2_1 ===
    if (obj.name && /^item(\d+)_(\d+)$/i.test(obj.name)) {
        const match = obj.name.match(/^item(\d+)_(\d+)$/i);
        if (match) {
            const group = parseInt(match[1]);
            const part = parseInt(match[2]);
            return `Деталь ${group}.${part}`;
        }
    }
    
    // Проверка userData для GLB частей
    if (obj.userData && obj.userData.partName && /^item\d+_\d+$/i.test(obj.userData.partName)) {
        const match = obj.userData.partName.match(/^item(\d+)_(\d+)$/i);
        if (match) {
            return `Деталь ${match[1]}.${match[2]}`;
        }
    }

    // === ПРИОРИТЕТ 2: userData из v2 или ручной разметки ===
    if (obj.userData) {
        if (obj.userData.displayName) return obj.userData.displayName;
        if (obj.userData.parentModelName) return obj.userData.parentModelName;
        if (obj.userData.modelName) return obj.userData.modelName;
        
        // Для v2 частей
        if (obj.userData.parentModelId && window.v2?.modelsMap) {
            const data = v2.modelsMap.get(obj.userData.parentModelId);
            if (data?.name) return data.name;
        }
    }

    // === ПРИОРИТЕТ 3: Имя файла модели (для всей GLB) ===
    if (window.currentModel && window.currentModel.userData) {
        if (window.currentModel.userData.sourceFile) {
            const fileName = window.currentModel.userData.sourceFile;
            const baseName = fileName.replace(/\.(glb|gltf)$/i, '').split('/').pop();
            if (baseName && baseName.length > 2) {
                return baseName;
            }
        }
        if (window.currentModel.userData.fileName) {
            return window.currentModel.userData.fileName;
        }
    }

    // === ПРИОРИТЕТ 4: Имя самого объекта (очищенное) ===
    if (obj.name && 
        obj.name.length > 3 && 
        !obj.name.startsWith('Object_') && 
        !obj.name.startsWith('Mesh_') && 
        !obj.name.startsWith('Scene') &&
        !obj.name.startsWith('Group') &&
        !/^\d+$/.test(obj.name)) {
        
        let cleanName = obj.name;
        cleanName = cleanName.replace(/^(Object_|Mesh_|Plane_|Cube_|Cylinder_|Sphere_|Group_)/, '');
        return cleanName;
    }

    // === ПРИОРИТЕТ 5: Поиск в родителях ===
    let parent = obj.parent;
    let depth = 0;
    while (parent && parent !== scene && depth < 10) {
        if (parent.name && 
            parent.name.length > 3 && 
            !parent.name.startsWith('Object_') && 
            !parent.name.startsWith('Mesh_') &&
            !parent.name.startsWith('Group')) {
            return parent.name;
        }
        parent = parent.parent;
        depth++;
    }

    // === ПРИОРИТЕТ 6: Поиск любой части item*_* в дереве ===
    let foundItem = null;
    if (obj.traverse) {
        obj.traverse((node) => {
            if (foundItem) return;
            if (node.name && /^item\d+_\d+$/i.test(node.name)) {
                foundItem = node.name;
            }
        });
        if (foundItem) {
            const match = foundItem.match(/^item(\d+)_(\d+)$/i);
            if (match) return `Деталь ${match[1]}.${match[2]}`;
        }
    }

    // === ПОСЛЕДНИЙ FALLBACK ===
    if (obj.isMesh) return 'Меш';
    if (obj.isGroup) return 'Группа';
    return obj.name || 'Часть модели';
}

